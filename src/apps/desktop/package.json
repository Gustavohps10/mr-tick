{
  "private": true,
  "name": "@mr-tick/desktop",
  "productName": "mr-tick",
  "version": "0.3.0-beta.5",
  "description": "Mr-tick Desktop App.",
  "author": "Gustavo Henrique",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gustavohps10/mr-tick.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "build:win": "yarn build && electron-builder --win",
    "test:win": "yarn build && electron-builder --win --dir -c.publish.provider=github && node -e \"const fs=require('fs'); const p='.output/win-unpacked/resources/app-update.yml'; if(!fs.existsSync(p)) fs.copyFileSync('dev-app-update.yml', p);\"",
    "build:mac": "yarn build && electron-builder --mac",
    "build:linux": "yarn build && electron-builder --linux",
    "native:rebuild": "node-gyp rebuild && node -e \"require('fs').cpSync('build/Release/window_overlay.node', 'native-prebuilds/window_overlay.node'); require('fs').cpSync('build/Release/updater.exe', 'native-prebuilds/updater.exe')\""
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@mr-tick/adapters": "workspace:*",
    "@mr-tick/application": "workspace:*",
    "@mr-tick/shared": "workspace:*",
    "@mr-tick/ui": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.6",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.1.7",
    "fake-indexeddb": "^6.2.5",
    "keytar": "^7.9.0",
    "lokijs": "^1.5.12",
    "node-addon-api": "^8.9.2",
    "nuqs": "^2.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.29.0",
    "rxdb": "^16.21.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-static-copy": "^3.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@rollup/plugin-image": "^3.0.3",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lokijs": "^1",
    "@types/node": "^20.17.18",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "electron": "31.0.2",
    "electron-builder": "26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^3.1.0",
    "node-gyp": "^13.0.1",
    "postcss": "^8.5.6",
    "prebuildify": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
