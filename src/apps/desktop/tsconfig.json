{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../../",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@mr-tick/IoC": ["../../packages/IoC.ts"],
      "@mr-tick/application/*": ["../../packages/application/src/*"],
      "@mr-tick/shared/*": ["../../packages/shared/src/*"],
      "@mr-tick/adapters/*": ["../../packages/adapters/src/*"]
    },
    "types": ["electron-vite/node", "node"]
  },
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/**/*",
    "src/renderer/@types",
    "../../packages/IoC.ts",
    "../sdk/package.json",
    "../../packages/ui/package.json"
  ],
  "references": [
    { "path": "../../packages/application" },
    { "path": "../../packages/shared" },
    { "path": "../../packages/adapters" },
    { "path": "../../packages/ui" }
  ]
}
