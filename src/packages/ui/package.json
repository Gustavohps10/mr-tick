    "rxdb": "^16.19.0",
    "sonner": "^2.0.6",
    "use-debounce": "^10.1.0",
    "vaul": "^1.1.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-input-mask": "^2",
