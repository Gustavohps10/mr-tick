{
  "name": "@mr-tick/ui",
  "version": "1.0.4",
  "private": true,
  "description": "Biblioteca de componentes de UI compartilhados para o ecossistema Mr-tick.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./assets": {
      "import": "./dist/assets/index.js",
      "types": "./dist/assets/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./layouts": {
      "import": "./dist/layouts/index.js",
      "types": "./dist/layouts/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    },
    "./pages": {
      "import": "./dist/pages/index.js",
      "types": "./dist/pages/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./globals.css": {
      "import": "./dist/styles/globals.css",
      "require": "./dist/styles/globals.css",
      "default": "./dist/styles/globals.css"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-dts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
