{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@mr-tick/application": ["src/packages/application/src"],
      "@mr-tick/application/*": ["src/packages/application/src/*"],

      "@mr-tick/adapters": ["src/packages/adapters/src"],
      "@mr-tick/adapters/*": ["src/packages/adapters/src/*"],

      "@mr-tick/shared": ["src/packages/shared/src"],
      "@mr-tick/shared/*": ["src/packages/shared/src/*"],

      "@mr-tick/domain": ["src/packages/domain/src"],
      "@mr-tick/domain/*": ["src/packages/domain/src/*"],

      "@mr-tick/sdk": ["src/apps/sdk/src"],
      "@mr-tick/sdk/*": ["src/apps/sdk/src/*"],

      "@mr-tick/ui": ["src/packages/ui/src"],
      "@mr-tick/ui/*": ["src/packages/ui/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.setup.ts",
    "mocks/**/*.ts"
  ],
  "exclude": [
    "src/dev-addons",
    "node_modules",
    "dist"
  ]
}