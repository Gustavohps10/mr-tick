@startuml IntegrationSyncReplication
title Sync Replication Flow
participant UI
participant SyncEngine
participant RxDB
participant Addon
participant DataSource

UI -> RxDB: Timer cria timeEntry (local)
RxDB -> RxDB: Persiste com syncStatus=pending_push

UI -> SyncEngine: triggerPush() (background)
SyncEngine -> RxDB: getPendingTimeEntries()
RxDB -> SyncEngine: timeEntries[]

loop Para cada timeEntry
    SyncEngine -> Addon: pushTimeEntry(timeEntry)
    Addon -> Addon: Map TimeEntry -> ExternalFormat
    Addon -> DataSource: POST /time_entries
    alt Sucesso
        DataSource -> Addon: 201 Created {id}
        Addon -> SyncEngine: OK
        SyncEngine -> RxDB: update syncStatus=synced, remoteId
    else Conflito 409
        DataSource -> Addon: 409 Conflict
        Addon -> SyncEngine: conflict
        SyncEngine -> RxDB: marcar syncStatus=conflict
        SyncEngine -> UI: notificar conflito
    end
end

SyncEngine -> UI: pushComplete()
@enduml
