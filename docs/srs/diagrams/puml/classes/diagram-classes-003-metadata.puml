@startuml ClassMetadata
title MR-TICK - Coleção metadata (SRS 6.3)
package "Core Models" {
    class Metadata {
        +String id
        +String sourceId
        +String connectionInstanceId
        +String dataSourceId
        +String syncStatus
        +DateTime lastPulledAt
        +Array taskStatuses
        +Array taskPriorities
        +Array activities
        +Array trackStatuses
        +Array participantRoles
        +Array estimationTypes
        +Boolean conflicted
    }
    
    class MetadataItem {
        +String id
        +String name
        +String icon
        +Object colors
    }
}
Metadata *-- MetadataItem : contains
note right of Metadata
  id: connectionInstanceId::sourceId
end note
note right of MetadataItem
  colors: badge, background, text, border
end note
@enduml
