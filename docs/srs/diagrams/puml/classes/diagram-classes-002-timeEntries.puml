@startuml ClassTimeEntries
title MR-TICK - Coleção timeEntries (SRS 6.2)
package "Core Models" {
    class TimeEntry {
        +String id
        +String remoteId
        +String connectionInstanceId
        +String dataSourceId
        +String syncStatus
        +Boolean remoteDeleted
        +Boolean deletionConfirmed
        +String remoteUpdatedAt
        +Object task
        +Object taskData
        +Object activity
        +Object user
        +DateTime startDate
        +DateTime endDate
        +Number timeSpent
        +String comments
        +DateTime createdAt
        +DateTime updatedAt
        +Enum timeStatus
        +Enum type
        +Array journal
        +Object timerConfig
        +Object conflictData
    }
}
note right of TimeEntry
  id: SHA-256 (connectionInstanceId::remoteId) ou UUID
  syncStatus: synced, pending_push, creating, conflict, local_only
  timeStatus: running, paused, finished
  type: increasing, decreasing, manual
end note
@enduml
