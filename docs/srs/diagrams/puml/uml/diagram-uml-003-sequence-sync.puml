@startuml SequenceSync
title Full Synchronization Sequence
actor User
participant UI
participant SyncEngine
participant RxDB
participant Addon
participant DataSource

User -> UI: Solicita sincronizar
UI -> SyncEngine: sync()

SyncEngine -> SyncEngine: Pull primeiro

SyncEngine -> RxDB: getCheckpoint()
RxDB -> SyncEngine: checkpoint
SyncEngine -> Addon: pull(checkpoint)
Addon -> DataSource: GET issues (checkpoint)
DataSource -> Addon: issues[]
Addon -> Addon: Map to internal
Addon -> SyncEngine: tasks[], metadata[]

SyncEngine -> RxDB: upsert tasks, metadata
SyncEngine -> RxDB: saveCheckpoint()

SyncEngine -> SyncEngine: Push apontamentos
SyncEngine -> RxDB: getPendingTimeEntries()
RxDB -> SyncEngine: timeEntries[]
loop cada timeEntry
    SyncEngine -> Addon: push(timeEntry)
    Addon -> DataSource: POST time_entries
    DataSource -> Addon: 201 Created
    SyncEngine -> RxDB: update syncStatus=synced, remoteId
end

SyncEngine -> UI: syncComplete()
UI -> User: Sincronização concluída
@enduml
